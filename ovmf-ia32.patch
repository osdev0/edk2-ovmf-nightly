+      //
+      // Note: no change to (*ImageHandle), the caller will release it.
+      //
+      return Status;
+    }
+
+    //
+    // Swap in the legacy-loaded image.
+    //
+    QemuUnloadKernelImage (*ImageHandle);
+    *ImageHandle = KernelImageHandle;
+    return QemuStartLegacyImage (KernelImageHandle);
+  }
+
+ #endif
   return Status;
 }
 
